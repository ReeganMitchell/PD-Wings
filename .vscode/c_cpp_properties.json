{
    "configurations": [
        {
            "name": "Jo Engine Saturn",
            "compilerPath": "${workspaceFolder}/../../Compiler/LINUX/bin/sh-none-elf-gcc-8.2.0",
            "compilerArgs": [
                "-m2"
            ],
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c99",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/../../jo_engine",
                "${workspaceFolder}/../../Compiler/WINDOWS/sh-elf/include"
            ],
            "defines": [
                "JO_COMPILE_WITH_TGA_SUPPORT",
                "JO_COMPILE_WITH_AUDIO_SUPPORT",
                "JO_COMPILE_WITH_FS_SUPPORT",
                "JO_COMPILE_WITH_3D_SUPPORT",
                "JO_COMPILE_WITH_PRINTF_SUPPORT",
                "JO_COMPILE_WITH_SPRITE_HASHTABLE",
                "JO_GLOBAL_MEMORY_SIZE_FOR_MALLOC=393216",
                "JO_MAX_SPRITE=255",
                "JO_MAX_FILE_IN_IMAGE_PACK=32",
                "JO_MAP_MAX_LAYER=8",
                "JO_MAX_SPRITE_ANIM=16",
                "JO_MAX_FS_BACKGROUND_JOBS=1",
                "JO_DEBUG",
                "JO_PAL_VERSION"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/../../jo_engine",
                    "${workspaceFolder}/../../Compiler/WINDOWS/sh-elf/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
